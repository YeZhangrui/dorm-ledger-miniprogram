/* 下拉选择组件：自带全部外观样式，只借用 app.wxss 里的颜色变量（CSS 变量会继承进组件） */

.ss-trigger {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: var(--surface);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.45;
}

.ss-trigger:active {
  background: var(--surface-2);
}

.ss-text {
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ss-trigger.is-empty {
  color: var(--ink-3);
}

.ss-chev {
  flex: 0 0 auto;
  font-size: 24rpx;
  line-height: 1;
  color: var(--ink-3);
}

/* ---------- 底部面板 ---------- */
.ss-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(10, 26, 20, 0.45);
}

.ss-sheet {
  width: 100%;
  max-height: 76vh;
  overflow-y: auto;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -24rpx 64rpx -32rpx rgba(10, 26, 20, 0.5);
}

.ss-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 99rpx;
  background: var(--line-strong);
}

.ss-hd {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.ss-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
}

.ss-sub {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--ink-3);
}

.ss-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 14rpx;
  padding: 22rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--surface-2);
}

.ss-item:active {
  opacity: 0.9;
}

.ss-item.on {
  border-color: var(--brand);
  background: var(--brand-soft);
}

.ss-item-main {
  flex: 1 1 auto;
  min-width: 0;
}

.ss-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.4;
  color: var(--ink);
}

.ss-item.on .ss-label {
  color: var(--brand-ink);
}

.ss-label-text {
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ss-tick {
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--brand);
}

.ss-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--ink-3);
  overflow-wrap: anywhere;
}

.ss-side {
  flex: 0 0 auto;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--danger);
  font-variant-numeric: tabular-nums;
}

/* 取消：比主按钮弱一档，但仍是整行可点 */
.ss-cancel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 88rpx;
  margin-top: 8rpx;
  border: 2rpx solid var(--line-strong);
  border-radius: 22rpx;
  background: var(--surface);
  color: var(--ink-2);
  font-size: 29rpx;
  font-weight: 600;
}

.ss-cancel:active {
  background: var(--surface-2);
}
