<view class="page-wrap">
  <view class="page-head">
    <view>
      <view class="h1">小票识别</view>
    </view>
  </view>

  <view class="card">
    <view class="field-block">
      <view class="field-head">
        <view class="lbl">🤖 AI 识图</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-head">
        <view class="lbl">小票照片</view>
      </view>
      <view class="filepick">
        <view class="filebtn" bindtap="chooseImage">📷 选择小票照片</view>
        <text class="muted">{{imagePath ? '已选择照片（点图片可放大）' : '未选择文件（JPG / PNG 均可）'}}</text>
      </view>
      <view wx:if="{{imagePath}}" class="scanwrap" bindtap="previewImage">
        <image src="{{imagePath}}" mode="widthFix" />
      </view>
      <view wx:if="{{imagePath}}" class="hint">本机预览，未上传任何服务器；点“识别”才会把这张图发给你配置的 AI 接口。</view>
    </view>

    <view class="field" style="margin-top:32rpx">
      <view class="lbl">或者：把票面文字粘到这里</view>
      <textarea
        class="textarea"
        value="{{text}}"
        bindinput="onText"
        maxlength="2000"
        placeholder-class="ph"
        placeholder="{{phText}}"
       show-confirm-bar="{{false}}" />
    </view>

    <view class="btn block" style="margin-top:32rpx" bindtap="recognize">{{loading ? 'AI 读图中…' : '识别这张小票'}}</view>
  </view>

  <view wx:if="{{draft}}" class="card result-card">
    <view class="card-head">
      <view>
        <view class="h2">识别结果</view>
        <view class="card-sub">逐行核对后再入账</view>
      </view>
      <text class="confidence">来源：{{provider}}</text>
    </view>

    <view class="grid2" style="margin-bottom:24rpx">
      <view class="stat"><view class="k">商家（识别）</view><view class="v">{{merchant}}</view></view>
      <view class="stat"><view class="k">票面日期</view><view class="v">{{dateText}}</view></view>
      <view class="stat"><view class="k">明细合计</view><view class="v">{{sumText}}</view></view>
      <view class="stat"><view class="k">票面总额</view><view class="v">{{totalText}}</view></view>
    </view>

    <view class="alert" wx:for="{{warnings}}" wx:key="*this">
      <text>🤖</text>
      <view class="t">{{item}}</view>
    </view>
    <view wx:if="{{!warnings.length}}" class="alert ok">
      <text>✅</text>
      <view class="t">明细与票面总额一致，核对后入账。</view>
    </view>

    <view class="field-grid" style="margin-top:24rpx">
      <view class="field">
        <view class="lbl">垫付人</view>
        <sheet-select
          title="谁先垫的钱"
          placeholder="选垫付人"
          options="{{payerOptions}}"
          index="{{payerIndex}}"
          bind:change="onPayer"
        />
      </view>
      <view class="field">
        <view class="lbl">入账日期</view>
        <picker mode="date" value="{{dateText}}" bindchange="onDate">
          <view class="date-value">{{dateText}}</view>
        </picker>
      </view>
    </view>

    <view class="field-block">
      <view class="field-head">
        <view class="lbl">参与人</view>
      </view>
      <view class="pick">
        <view
          class="p {{p.on ? 'on' : ''}}"
          wx:for="{{parts}}"
          wx:for-item="p"
          wx:key="name"
          data-i="{{index}}"
          bindtap="togglePart"
        >{{p.on ? '✓' : '＋'}}{{p.name}}</view>
      </view>
    </view>

    <view class="field-block">
      <view class="field-head">
        <view class="lbl">明细行</view>
        <text class="hint-inline">取消勾选＝这笔不入账；名称 / 金额可直接改</text>
      </view>
      <view class="rline" wx:for="{{lines}}" wx:key="id">
        <view class="ck {{item.use ? 'on' : ''}}" data-i="{{index}}" bindtap="toggleLine">{{item.use ? '✓' : ''}}</view>
        <input class="rl-name" value="{{item.name}}" data-i="{{index}}" bindinput="onLineName" placeholder-class="ph" placeholder="项目名" />
        <input class="rl-amt" type="digit" value="{{item.amountText}}" data-i="{{index}}" bindinput="onLineAmount" placeholder-class="ph" placeholder="0.00" />
        <text wx:if="{{item.low}}" class="tag low">请核对</text>
      </view>
      <view wx:if="{{!lines.length}}" class="empty">没有解析出明细行</view>
    </view>

    <view class="fold">
      <view class="fold-head" bindtap="toggleFold">
        <text>查看 OCR 原始文字 / 解析出的 JSON</text>
        <text class="fold-chev">{{foldOpen ? '⌃' : '⌄'}}</text>
      </view>
      <view wx:if="{{foldOpen}}" class="code"><text class="pre-wrap">{{rawText}}</text></view>
    </view>

    <view class="actionbar">
      <view class="btn" bindtap="onMerge">合并成一笔入账</view>
      <view class="btn ghost" bindtap="onEach">逐条入账</view>
      <view class="btn ghost" bindtap="cancelDraft">取消</view>
    </view>
  </view>
</view>
