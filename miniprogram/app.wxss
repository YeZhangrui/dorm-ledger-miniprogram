page{
  --font-sans:"Segoe UI Variable Text","Segoe UI",-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei","Noto Sans SC",sans-serif;
  --font-num:"Segoe UI Variable Text","Segoe UI",system-ui,sans-serif;

  --paper:#f4f2ec;
  --paper-2:#eeece4;
  --surface:#fffefb;
  --surface-2:#f7f5ef;
  --ink:#15221c;
  --ink-2:#3c4942;
  --ink-3:#55625b;
  --ink-4:#5c6761;
  --line:#e3dfd3;
  --line-strong:#d2ccbd;

  --brand:#116e56;
  --brand-strong:#0c5945;
  --brand-soft:#e7f2ec;
  --brand-ink:#0a4635;

  --danger:#9c3636;
  --danger-soft:#fceeec;
  --amber:#7d5214;
  --amber-soft:#fbf1de;
  --gold:#d9b979;
  --gold-ink:#efe1c5;

  --header:#0d3b2d;
  --header-2:#0a2b21;
  --on-header:#f8f4e9;
  --on-header-2:rgba(248,244,233,.8);

  --shadow-sm:0 4rpx 14rpx -6rpx rgba(21,34,28,.09);
  --shadow-md:0 36rpx 88rpx -56rpx rgba(21,34,28,.35);
  --radius:32rpx;

  --shell:2240rpx;
  --view:2112rpx;
}view,text,image,button,input,textarea,picker,scroll-view,swiper,form,label,radio,switch,checkbox,slider,navigator{box-sizing:border-box}
page{height:100%}page{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:var(--font-sans);
  font-size:31rpx;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
  text-rendering:optimizeLegibility;
}view,input,picker,textarea{font:inherit;color:inherit}view{cursor:pointer}image{display:block}.h1,.h2,.p{margin:0}.topbar{
  order:1;
  flex:0 0 auto;
  position:relative;
  overflow:hidden;
  color:var(--on-header);
  background:
    radial-gradient(1520rpx 600rpx at 10% -30%, rgba(217,185,121,.16), transparent 62%),
    linear-gradient(132deg,#0f3d2e 0%,var(--header-2) 78%);
  border-bottom:2rpx solid rgba(217,185,121,.22);
}.topbar::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.035) 2rpx,transparent 2rpx);
  background-size:100% 92rpx;
  -webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 34%,transparent 100%);
  mask-image:linear-gradient(180deg,transparent 0%,#000 34%,transparent 100%);
}.topbar-inner{
  position:relative;
  z-index:1;
  width:100%;
  max-width:var(--shell);
  margin:0 auto;
  padding:44rpx 64rpx 52rpx;
}.brand-mark{
  width:84rpx;height:84rpx;flex:0 0 auto;
  display:grid;place-items:center;
  color:var(--gold);
  background:rgba(255,255,255,.06);
  border:2rpx solid rgba(217,185,121,.42);
  border-radius:26rpx;
  box-shadow:inset 0 2rpx 0 rgba(255,255,255,.08);
}.brand-mark image{width:44rpx;height:44rpx;stroke:currentColor;fill:none;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}.brand-kicker{
  /* 金色小字叠在带金色光斑的深绿底上，用更亮的金保证 ≥7:1 */
  font-size:20rpx;font-weight:650;letter-spacing:.22em;
  color:var(--gold-ink);text-transform:uppercase;
  line-height:1.4;margin-bottom:2rpx;
}.dorm{
  font-size:32rpx;font-weight:650;letter-spacing:.01em;line-height:1.35;
  color:var(--on-header);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}.status{
  margin-top:2rpx;
  font-size:25rpx;line-height:1.4;color:var(--on-header-2);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}.top-actions{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap;justify-content:flex-end}.icon-btn{
  display:inline-flex;align-items:center;justify-content:center;gap:14rpx;
  height:68rpx;padding:0 24rpx;
  border-radius:1998rpx;
  border:2rpx solid rgba(247,242,230,.2);
  background:rgba(255,255,255,.055);
  color:var(--on-header);
  font-size:25rpx;font-weight:550;line-height:1;
  transition:background .16s,border-color .16s,transform .1s;
}.icon-btn image{width:30rpx;height:30rpx;opacity:.92;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.icon-btn:hover{background:rgba(255,255,255,.13);border-color:rgba(247,242,230,.36)}.icon-btn:active{transform:translateY(2rpx)}.icon-btn.danger-ghost{color:#f1c9c2;border-color:rgba(241,201,194,.3)}.icon-btn.danger-ghost:hover{background:rgba(190,90,80,.24);border-color:rgba(241,201,194,.48)}.icon-btn.chev{width:68rpx;padding:0;border-radius:50%;font-size:28rpx;line-height:1}.hero{
  margin-top:44rpx;
  display:flex;align-items:flex-end;justify-content:space-between;gap:44rpx;
  flex-wrap:wrap;
}.hero-main{min-width:0}.hero .label{
  display:flex;align-items:center;gap:16rpx;
  font-size:24rpx;font-weight:600;letter-spacing:.1em;
  color:var(--on-header-2);
}.hero .label::before{content:"";width:12rpx;height:12rpx;border-radius:50%;background:var(--gold);flex:0 0 auto}.hero .amount{
  margin-top:8rpx;
  font-family:var(--font-num);
  font-size:clamp(76rpx,4.4vw,108rpx);
  font-weight:720;
  line-height:1.05;
  letter-spacing:-.025em;
  color:#fffdf6;
  font-variant-numeric:tabular-nums;
  white-space:nowrap;
}.hero .sub{
  margin-top:14rpx;
  font-size:27rpx;line-height:1.5;
  color:var(--on-header-2);
  font-variant-numeric:tabular-nums;
}.hero-mini{display:none}.hero-meta{
  display:inline-flex;align-items:center;gap:16rpx;
  margin-bottom:8rpx;padding:16rpx 24rpx;
  border:2rpx solid rgba(247,242,230,.14);
  border-radius:1998rpx;
  background:rgba(255,255,255,.04);
  color:rgba(247,242,230,.66);
  font-size:23rpx;line-height:1.2;white-space:nowrap;
}.hero-meta::before{content:"";width:12rpx;height:12rpx;border-radius:50%;background:#5fbf9f;box-shadow:0 0 0 6rpx rgba(95,191,159,.16)}.topbar.min .topbar-inner{padding-top:28rpx;padding-bottom:28rpx}.topbar.min .brand-kicker{display:none}.topbar.min .hero{margin-top:20rpx}.topbar.min .hero .label, .topbar.min .hero .amount, .topbar.min .hero .sub, .topbar.min .hero-meta{display:none}.topbar.min .hero-mini{
  display:block;
  font-size:28rpx;font-weight:550;letter-spacing:.01em;
  color:var(--on-header);
  font-variant-numeric:tabular-nums;
}.topbar.min .brand-mark{width:72rpx;height:72rpx;border-radius:22rpx}.topbar.min .brand-mark image{width:38rpx;height:38rpx}
/* 页面内容容器：小程序里页面本身就会滚动，这里只做块级容器，不再套一层滚动区 */
.content{
  display:block;
  padding:0;
}.page-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;flex-wrap:wrap;margin:0}.page-head .h1{margin:0;font-size:44rpx;line-height:1.3;font-weight:700;letter-spacing:-.01em}.page-head .p{margin:10rpx 0 0;font-size:26rpx;line-height:1.6;color:var(--ink-3)}.card{
  background:var(--surface);
  border:2rpx solid var(--line);
  border-radius:var(--radius);
  box-shadow:var(--shadow-sm);
  padding:36rpx;
}.home-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:36rpx;align-items:start}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin-bottom:28rpx}.card-head .h2{display:flex;align-items:center;gap:14rpx;margin:0;font-size:33rpx;font-weight:650;line-height:1.4;letter-spacing:.004em}.card-head .h2::before{content:"";width:6rpx;height:26rpx;flex:0 0 auto;border-radius:4rpx;background:var(--brand)}.card-sub{margin:6rpx 0 0;font-size:25rpx;line-height:1.5;color:var(--ink-3)}.card-sub:empty{display:none}.note{
  margin:26rpx 0 0;padding-top:22rpx;
  border-top:2rpx dashed var(--line);
  font-size:24rpx;line-height:1.65;color:var(--ink-3);
}.hint{margin:22rpx 0 0;font-size:26rpx;line-height:1.65;color:var(--ink-3)}.muted{color:var(--ink-3);font-size:26rpx}.link{
  border:0;background:none;color:var(--brand);
  font-size:26rpx;font-weight:650;padding:8rpx 4rpx;border-radius:12rpx;
  white-space:nowrap;
}.link:hover{text-decoration:underline;text-underline-offset:6rpx}.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:14rpx;
  width:100%;min-height:88rpx;padding:20rpx 32rpx;
  border:2rpx solid transparent;border-radius:22rpx;
  background:var(--brand);color:#fff;
  font-size:29rpx;font-weight:650;letter-spacing:.01em;line-height:1.3;
  box-shadow:0 16rpx 34rpx -26rpx rgba(17,110,86,.95);
  transition:background .15s,transform .1s,box-shadow .15s,border-color .15s;
}.btn:hover{background:var(--brand-strong)}.btn:active{transform:translateY(2rpx)}.btn image{width:34rpx;height:34rpx;stroke:currentColor;fill:none;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}.btn.ghost{background:var(--surface);color:var(--ink-2);border-color:var(--line-strong);box-shadow:none}.btn.ghost:hover{background:var(--surface-2);color:var(--ink)}.btn.danger{background:var(--danger-soft);color:var(--danger);border-color:#efd1ce;box-shadow:none}.btn.danger:hover{background:#f8dedb}.btn.sm{width:auto;min-height:68rpx;padding:12rpx 24rpx;border-radius:16rpx;font-size:25rpx;font-weight:600;gap:10rpx;box-shadow:none}.cta{min-height:100rpx;font-size:31rpx;margin-top:4rpx}.actionbar,.rowbtns{display:flex;align-items:center;gap:20rpx;flex-wrap:wrap;margin-top:32rpx}.actionbar .btn{flex:1 1 260rpx;width:auto}.rowbtns .btn{flex:0 1 auto}.field{display:flex;flex-direction:column;gap:12rpx;min-width:0}.field > .lbl{font-size:25rpx;font-weight:600;letter-spacing:.02em;color:var(--ink-2)}input,picker,textarea{
  width:100%;min-width:0;
  min-height:88rpx;padding:18rpx 24rpx;
  border:2rpx solid var(--line-strong);border-radius:20rpx;
  background:#fffdf8;color:var(--ink);
  font-size:29rpx;line-height:1.45;
  outline:none;
  transition:border-color .15s,box-shadow .15s,background .15s;
}textarea{min-height:224rpx;padding:24rpx 26rpx;resize:vertical;line-height:1.65}input{font-variant-numeric:tabular-nums}input:hover,textarea:hover{border-color:#c1baa9}input:focus,textarea:focus{border-color:var(--brand);background:#fff;box-shadow:0 0 0 6rpx rgba(17,110,86,.12)}
/* 微信默认 placeholder 是 rgba(0,0,0,.3)，在白底上只有约 2.1:1，几乎看不清；
   所有 input/textarea 统一挂 placeholder-class="ph"，对比度提到 5:1 以上。 */
.ph{color:var(--ink-4)}.field-grid{display:grid;grid-template-columns:1fr 1fr;gap:26rpx 28rpx;margin-bottom:26rpx}.field-block{margin:26rpx 0}.field-head{display:flex;align-items:baseline;justify-content:space-between;gap:20rpx;margin-bottom:14rpx;flex-wrap:wrap}.field-head .lbl{font-size:24rpx;font-weight:650;letter-spacing:.02em;color:var(--ink-2);flex:0 0 auto;white-space:nowrap}.hint-inline{font-size:24rpx;line-height:1.4;color:var(--ink-3)}
/* ===== 二级菜单：标签式切换（自己设计的） =====
   设计意图：
   - 白底 + 一条发丝底线，像"页签"而不是"按钮组"，和底部 tabBar 是同一套"选中=品牌绿"的语言；
   - 选中项：品牌绿文字 + 下方 6rpx 圆角短条，短条宽度只到文字宽度，视觉上更克制；
   - 均分宽度、高度一致，和卡片左右边缘严格对齐（外层不再加 margin/padding 偏移）。 */
.seg{
  display:flex;align-items:stretch;
  width:100%;
  padding:0;
  margin:0;
  background:transparent;
  border:0;
  border-bottom:2rpx solid var(--line);
}.seg view{
  position:relative;
  flex:1 1 0;min-width:0;
  display:flex;align-items:center;justify-content:center;
  min-height:88rpx;
  padding:0 12rpx 16rpx;
  font-size:29rpx;font-weight:600;color:var(--ink-3);line-height:1.25;
  transition:color .16s;
}.seg view:active{opacity:.75}.seg view.on{color:var(--brand);font-weight:700}.seg view.on::after{
  content:"";
  position:absolute;left:50%;bottom:-2rpx;transform:translateX(-50%);
  width:56rpx;height:6rpx;border-radius:1998rpx;
  background:var(--brand);
}.seg.compact{width:auto;max-width:none;flex:0 0 auto;border-bottom:0}.seg.compact view{flex:0 0 auto;padding:0 28rpx}
.tone-picker{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10rpx;
  padding:8rpx;border:2rpx solid var(--line);border-radius:28rpx;
  background:var(--surface-2);
}.tone-option{
  display:flex;flex-direction:column;align-items:flex-start;gap:4rpx;
  min-width:0;padding:16rpx 18rpx;
  border:2rpx solid transparent;border-radius:22rpx;
  background:transparent;color:var(--ink-2);text-align:left;line-height:1.3;
  transition:background .15s,border-color .15s,color .15s,box-shadow .15s;
}.tone-option:active{opacity:.92}.tone-option.on{background:var(--brand);border-color:var(--brand);color:#fff;box-shadow:0 10rpx 22rpx -16rpx rgba(17,110,86,.95)}.tone-name{font-size:27rpx;font-weight:700;line-height:1.3}.tone-desc{font-size:22rpx;line-height:1.35;color:var(--ink-3)}.tone-option.on .tone-desc{color:rgba(255,255,255,.92)}.pick{display:flex;flex-wrap:wrap;gap:16rpx}.pick .p{
  display:inline-flex;align-items:center;gap:12rpx;
  min-height:76rpx;padding:14rpx 24rpx;
  border:2rpx solid var(--line-strong);border-radius:1998rpx;
  background:#fffdf8;color:var(--ink-2);
  font-size:27rpx;line-height:1.2;cursor:pointer;
  transition:background .15s,border-color .15s,color .15s;
}.pick .p:hover{border-color:#b9b2a2;background:#fff}.pick .p text{font-size:26rpx;color:var(--ink-3);line-height:1}.pick .p.on{background:var(--brand-soft);border-color:var(--brand);color:var(--brand-ink);font-weight:650}.pick .p.on text{color:var(--brand)}.days{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:20rpx}.pill{
  display:inline-flex;align-items:center;gap:12rpx;
  padding:10rpx 20rpx;
  border:2rpx solid #cbe5d9;border-radius:1998rpx;
  background:var(--brand-soft);color:var(--brand-ink);
  font-size:24rpx;font-weight:600;line-height:1.2;white-space:nowrap;
}.confidence{
  display:inline-flex;align-items:center;
  padding:8rpx 18rpx;border:2rpx solid #cbe5d9;border-radius:1998rpx;
  background:var(--brand-soft);color:var(--brand-ink);
  font-size:23rpx;font-weight:600;line-height:1.3;white-space:nowrap;
}.tag{
  display:inline-flex;align-items:center;gap:8rpx;
  height:44rpx;padding:0 16rpx;
  border:2rpx solid var(--line);border-radius:1998rpx;
  background:var(--surface-2);color:var(--ink-2);
  font-size:23rpx;font-weight:600;line-height:1;white-space:nowrap;
  vertical-align:middle;
}.tag.ok{background:var(--brand-soft);border-color:#c9e5d9;color:var(--brand-ink)}.tag.no{background:var(--danger-soft);border-color:#f0d3d0;color:var(--danger)}.tag.rc{background:#eef2f8;border-color:#d8e2ef;color:#3c5a7a}.tag.low{background:var(--amber-soft);border-color:#ead6b3;color:var(--amber)}.alert{
  display:flex;align-items:flex-start;gap:20rpx;
  margin:0 0 20rpx;padding:24rpx 28rpx;
  border:2rpx solid #ecd7b6;border-radius:24rpx;
  background:var(--amber-soft);color:#6f4a10;
  font-size:26rpx;line-height:1.6;
}.alert:last-child{margin-bottom:0}.alert > view:first-child{flex:0 0 auto;font-size:30rpx;line-height:1.35}.alert .t{min-width:0}.alert .strong{font-weight:700}.alert.ok{background:var(--brand-soft);border-color:#c6e2d5;color:var(--brand-ink)}.empty{
  padding:52rpx 32rpx;text-align:center;
  border:2rpx dashed var(--line-strong);border-radius:24rpx;
  background:var(--surface-2);
  color:var(--ink-3);font-size:26rpx;line-height:1.6;
}.people{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.person{
  display:grid;grid-template-columns:16rpx minmax(0,1fr) auto;align-items:center;gap:18rpx;
  min-width:0;padding:22rpx 24rpx;
  border:2rpx solid var(--line);border-radius:24rpx;
  background:var(--surface-2);
}.person::before{content:"";width:14rpx;height:14rpx;border-radius:50%;background:var(--ink-3)}.person.pos::before{background:var(--brand)}.person.neg::before{background:#c25b4e}.person .n{
  display:flex;align-items:center;gap:12rpx;min-width:0;
  font-size:27rpx;font-weight:600;line-height:1.4;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}.person .b{
  font-size:30rpx;font-weight:700;line-height:1.4;
  font-variant-numeric:tabular-nums;white-space:nowrap;
}.person .b.pos{color:var(--brand)}.person .b.neg{color:var(--danger)}.person.out .nm{color:var(--ink-3)}.ex{
  flex:0 0 auto;padding:2rpx 12rpx;
  border:2rpx solid var(--line-strong);border-radius:1998rpx;
  font-size:22rpx;font-weight:500;color:var(--ink-3);line-height:1.5;
}.rec{
  display:grid;grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;gap:24rpx;
  padding:26rpx 0;
}.rec + .rec{border-top:2rpx dashed var(--line)}.rec .ico{
  width:76rpx;height:76rpx;flex:0 0 auto;
  display:grid;place-items:center;
  border-radius:22rpx;background:var(--brand-soft);
  font-size:34rpx;line-height:1;
}.rec .mid{min-width:0}.rec .title{
  display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;
  font-size:29rpx;font-weight:600;line-height:1.45;
}.rec .meta{margin-top:4rpx;font-size:25rpx;line-height:1.55;color:var(--ink-3)}.rec > view:last-child{display:flex;flex-direction:column;align-items:flex-end;gap:12rpx;flex:0 0 auto}.rec .amt{font-size:32rpx;font-weight:700;line-height:1.3;font-variant-numeric:tabular-nums;white-space:nowrap}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.stat{
  min-width:0;padding:24rpx 26rpx;
  border:2rpx solid var(--line);border-radius:24rpx;
  background:var(--surface-2);
}.stat .k{font-size:24rpx;line-height:1.4;color:var(--ink-3)}.stat .v{
  margin-top:4rpx;
  font-size:38rpx;font-weight:700;line-height:1.35;
  font-variant-numeric:tabular-nums;
  overflow-wrap:anywhere;
}.stat .v.pos{color:var(--brand)}.stat .v.neg{color:var(--danger)}.bars{margin:32rpx 0 8rpx}.bars .b{margin-bottom:24rpx}.bars .b:last-child{margin-bottom:0}.bars .l{display:flex;align-items:baseline;justify-content:space-between;gap:20rpx;margin-bottom:10rpx;font-size:25rpx;line-height:1.4;color:var(--ink-2)}.bars .l text:last-child{color:var(--ink-3);font-variant-numeric:tabular-nums;white-space:nowrap}.bar{height:16rpx;border-radius:1998rpx;background:#edeae1;overflow:hidden}.quote{
  position:relative;
  margin-top:32rpx;padding:32rpx 32rpx 32rpx 38rpx;
  border:2rpx solid #cfe5da;border-radius:28rpx;
  background:linear-gradient(180deg,#f2f8f4,#ebf4ef);
  color:#1d3c30;
  font-size:28rpx;line-height:1.78;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
}.quote::before{
  content:"";position:absolute;left:0;top:28rpx;bottom:28rpx;width:6rpx;
  border-radius:6rpx;background:var(--brand);opacity:.42;
}.samples{margin-top:28rpx}.samples-label{display:block;margin-bottom:14rpx;font-size:25rpx;font-weight:600;letter-spacing:.03em;color:var(--ink-3)}.chips{display:flex;flex-wrap:wrap;gap:14rpx}.chip{
  display:inline-flex;align-items:center;
  min-height:72rpx;padding:16rpx 24rpx;
  border:2rpx solid var(--line);border-radius:1998rpx;
  background:var(--surface);color:var(--ink-2);
  font-size:25rpx;line-height:1.3;cursor:pointer;
  transition:background .15s,border-color .15s,color .15s;
}.chip:hover{background:var(--brand-soft);border-color:#b9dccc;color:var(--brand-ink)}.chip:active{transform:translateY(2rpx)}.result-card{animation:rise .22s ease-out both}
@keyframes rise{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
/* ===== 折叠区（"查看 JSON / OCR 原文"）=====
   小程序没有 details/summary，改成 bindtap 切换 wx:if，箭头随状态变化。 */
.fold{
  margin-top:26rpx;
  border:2rpx solid var(--line);border-radius:24rpx;
  background:var(--surface-2);
  overflow:hidden;
}.fold-head{
  display:flex;align-items:center;justify-content:space-between;gap:16rpx;
  padding:22rpx 24rpx;
  font-size:25rpx;font-weight:600;color:var(--ink-2);line-height:1.45;
}.fold-head:active{background:var(--paper-2)}.fold-chev{flex:0 0 auto;font-size:22rpx;color:var(--ink-3);line-height:1}.fold .code{margin:0 20rpx 20rpx}.code{
  margin:0 0 24rpx;padding:26rpx 28rpx;
  border-radius:20rpx;
  background:#10241d;color:#d7e5dc;
  font-family:ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;
  font-size:23rpx;line-height:1.65;
  overflow:auto;max-height:640rpx;
  -webkit-overflow-scrolling:touch;
}.filepick{position:relative;margin-top:4rpx}.filebtn{
  display:flex;align-items:center;gap:26rpx;
  width:100%;padding:30rpx 32rpx;
  border:3rpx dashed #c9c3b3;border-radius:28rpx;
  background:#fbf9f4;color:var(--ink);
  cursor:pointer;user-select:none;
  transition:background .15s,border-color .15s;
}.filebtn:hover{background:var(--brand-soft);border-color:var(--brand)}.filebtn image{width:52rpx;height:52rpx;flex:0 0 auto;color:var(--brand);stroke:currentColor;fill:none;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}.filebtn .strong{display:block;font-size:28rpx;font-weight:650;line-height:1.4}.scanwrap{position:relative;overflow:hidden;margin-top:24rpx;border:2rpx solid var(--line);border-radius:24rpx;max-width:860rpx}.rline{
  display:grid;grid-template-columns:48rpx minmax(0,1fr) 184rpx auto;
  align-items:center;gap:16rpx;
  padding:16rpx 0;
}.rline + .rline{border-top:2rpx dashed var(--line)}.rline .ck{
  width:44rpx;height:44rpx;
  display:grid;place-items:center;
  border:3rpx solid var(--line-strong);border-radius:14rpx;
  background:var(--surface);color:#fff;
  font-size:24rpx;line-height:1;cursor:pointer;
  transition:background .15s,border-color .15s;
}.rline .ck.on{background:var(--brand);border-color:var(--brand)}.rline input{
  min-height:76rpx;padding:14rpx 20rpx;
  border:2rpx solid var(--line);border-radius:16rpx;
  background:var(--surface);font-size:27rpx;
}.rline .rl-name{text-align:left}.rline .rl-amt{text-align:right;font-variant-numeric:tabular-nums}.rline .tag{justify-self:end}#listOut{display:flex;flex-direction:column;gap:28rpx;width:100%}#listOut .card{padding:32rpx 32rpx}#listOut .card .h3{
  display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;
  margin:0 0 12rpx;
  font-size:32rpx;font-weight:650;line-height:1.45;
}#listOut .card .h3 > text:first-child{min-width:0;overflow-wrap:anywhere}#listOut .card .h3 .muted{flex:0 0 auto;font-size:24rpx;font-weight:500;padding-top:4rpx}#listOut .card > .muted{margin:0 0 8rpx;line-height:1.6;overflow-wrap:anywhere}#listOut .card > .field{
  display:flex;flex-direction:row;flex-wrap:wrap;align-items:baseline;gap:8rpx 20rpx;
  margin:8rpx 0 20rpx;padding:0;
  border:0;border-radius:0;
  background:transparent;
}#listOut .card > .field > .lbl{font-size:23rpx;font-weight:600;color:var(--ink-3);letter-spacing:.02em}#listOut .card > .field > view{font-size:40rpx;font-weight:700;line-height:1.3;font-variant-numeric:tabular-nums;flex:0 0 auto !important}#listOut .card > .field > .muted{margin-left:0;font-size:24rpx}#listOut .rowbtns{margin-top:4rpx}#listOut .rowbtns .btn{flex:0 1 auto}/* ===== 成员行（members 页） ===== */
.mrow{
  display:grid;grid-template-columns:minmax(0,1fr) auto 68rpx;
  align-items:center;gap:16rpx;
  margin-bottom:16rpx;padding:16rpx 20rpx;
  border:2rpx solid var(--line);border-radius:24rpx;
  background:var(--surface-2);
}.mrow input{min-height:80rpx;padding:16rpx 20rpx;border-radius:18rpx;background:#fff;font-size:28rpx}.mrow .del{
  width:68rpx;height:68rpx;
  display:grid;place-items:center;
  border:2rpx solid #efd0cd;border-radius:18rpx;
  background:var(--danger-soft);color:var(--danger);
  font-size:26rpx;line-height:1;
}.mrow .del:hover{background:#f8dedb}
/* ===== 房间码 pill / 房间页 ===== */
.room-pill{
  display:inline-flex;align-items:center;gap:10rpx;
  margin-top:12rpx;padding:6rpx 18rpx 6rpx 14rpx;max-width:100%;
  border:2rpx solid rgba(248,244,233,.3);border-radius:1998rpx;
  background:rgba(255,255,255,.07);color:var(--on-header);
  font-size:23rpx;line-height:1.5;letter-spacing:.02em;font-weight:600;
  font-variant-numeric:tabular-nums;
  transition:background .15s,border-color .15s;
}.room-pill:hover{background:rgba(255,255,255,.13);border-color:rgba(248,244,233,.44)}.room-pill:active{transform:translateY(2rpx)}.room-pill image{width:26rpx;height:26rpx;flex:0 0 auto;opacity:.9;stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.room-pill text{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.room-pill-chev{opacity:.72;font-size:26rpx;line-height:1;flex:0 0 auto}.room-current{
  display:flex;align-items:center;justify-content:space-between;gap:24rpx;
  margin:8rpx 0 24rpx;padding:28rpx 32rpx;
  border:2rpx solid var(--line);border-radius:28rpx;background:var(--surface-2);
}.room-current-main{min-width:0}.room-code{
  font-family:var(--font-num);font-size:46rpx;font-weight:700;line-height:1.2;
  letter-spacing:.1em;color:var(--brand-ink);
  overflow-wrap:anywhere;
}.room-meta{margin-top:6rpx;font-size:23rpx;line-height:1.5;color:var(--ink-3)}.room-current .btn{flex:0 0 auto}.room-join{display:flex;align-items:stretch;gap:16rpx;margin-top:16rpx}.room-join input{
  flex:1 1 auto;min-width:0;min-height:80rpx;
  font-family:var(--font-num);letter-spacing:.12em;text-transform:uppercase;
}.room-join .btn{flex:0 0 auto}.room-list{display:grid;gap:16rpx;margin:16rpx 0 0}.room-item{
  display:flex;align-items:center;gap:20rpx;width:100%;
  padding:20rpx 24rpx;border:2rpx solid var(--line);border-radius:24rpx;
  background:var(--surface-2);color:var(--ink);text-align:left;
  transition:background .15s,border-color .15s;
}.room-item:hover{background:var(--brand-soft);border-color:#b9dccc}.room-item.on{border-color:var(--brand);background:var(--brand-soft);box-shadow:inset 0 0 0 2rpx rgba(17,110,86,.12)}.room-item-code{
  flex:0 0 auto;font-family:var(--font-num);font-size:27rpx;font-weight:700;
  letter-spacing:.1em;color:var(--brand-ink);
}.room-item-meta{
  flex:1 1 auto;min-width:0;font-size:23rpx;line-height:1.5;color:var(--ink-3);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}.room-item-check{flex:0 0 auto;font-size:22rpx;font-weight:650;color:var(--brand)}.room-io{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:32rpx}

.h3{margin:0;font-size:32rpx;font-weight:650;line-height:1.45}#listOut .card .h3{display:flex;align-items:flex-start;justify-content:space-between;gap:24rpx;margin:0 0 12rpx}#listOut .card .h3 .t{min-width:0;overflow-wrap:anywhere}#listOut .card .h3 .muted{flex:0 0 auto;font-size:24rpx;font-weight:500;padding-top:4rpx}.page-wrap{padding:32rpx 32rpx 48rpx;display:flex;flex-direction:column;gap:28rpx}.page-wrap > .card{margin:0}.content{padding:0}.lbl{display:block;font-size:25rpx;color:var(--ink-2);margin-bottom:10rpx;font-weight:600}.field .lbl + .input,.field .lbl + .textarea{width:100%}.input,.textarea{box-sizing:border-box;width:100%;background:var(--surface);border:2rpx solid var(--line);
  border-radius:18rpx;padding:18rpx 22rpx;font-size:28rpx;line-height:1.5;color:var(--ink)}.textarea{min-height:180rpx}.btn{cursor:pointer}.btn.block{display:block;width:100%;text-align:center;box-sizing:border-box}.chip.tap:active,.tag.tap:active,.room-item:active,.rec .btn:active{opacity:.75}.row-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.pre-wrap{white-space:pre-wrap;word-break:break-word}
