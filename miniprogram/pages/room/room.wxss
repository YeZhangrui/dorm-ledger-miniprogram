/* 房间码页局部样式：通用样式在 app.wxss，这里只补本页特有的部分 */

.room-join {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.room-join .input {
  flex: 1;
  min-width: 0;
}

.room-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.room-io {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.import-box {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--line);
}

.code-input {
  height: 260rpx;
  font-family: var(--font-num);
  font-size: 22rpx;
}

.import-preview {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--surface-2);
  border: 2rpx solid var(--line);
}

.import-info {
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--ink-2);
  margin-bottom: 12rpx;
}

/* 页脚入口：隐私政策与用户协议（审核要求"在小程序内可访问"） */
.about-link {
  text-align: center;
  padding: 8rpx 0 28rpx;
}

/* 云端房间卡片 */
.cloud-room {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 26rpx;
  border: 2rpx solid #cbe5d9;
  border-radius: 24rpx;
  background: var(--brand-soft);
}

.cloud-room-code {
  flex: 0 0 auto;
  font-family: var(--font-num);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: .1em;
  color: var(--brand-ink);
}

.cloud-room-main {
  flex: 1 1 auto;
  min-width: 0;
}

.cloud-room-name {
  font-size: 28rpx;
  font-weight: 650;
  color: var(--brand-ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cloud-room-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #4d7c6a;
}

.cloud-room-empty .hint {
  margin-top: 0;
}

/* 自检入口：一行小字，点开弹结果 */
.cloud-check {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
  text-align: right;
}

/* 云端房间的操作按钮 */
/* 四个操作按钮：2×2 等宽网格，左右严格对齐 */
.cloud-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cloud-actions .btn {
  width: 100%;
  margin: 0;
  box-sizing: border-box;
}

.cloud-actions .share-btn {
  width: 100%;
}

/* 分享是 <button open-type="share">，把默认边框/背景清掉，和 .btn 一致 */
.share-btn::after {
  border: 0;
}

.share-btn {
  margin: 0;
  line-height: 1.3;
}
